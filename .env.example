# ==================================
# BACKEND ENV (.env)
# ==================================

# App
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis (Upstash)
REDIS_URL=redis://default:[PASSWORD]@[ENDPOINT].upstash.io:6379
REDIS_TOKEN=your-upstash-redis-token

# OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxx
EMAIL_FROM=SubTrack Pro <noreply@subtrack.app>

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4-turbo-preview

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_MONTHLY=price_xxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID_YEARLY=price_xxxxxxxxxxxxxxxxxx

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ==================================
# FRONTEND ENV (.env.local)
# ==================================

# API
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxx

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-preset

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxx

# ==================================
# PRODUCTION DEPLOYMENT
# ==================================

# Vercel (Frontend)
# Set these in Vercel dashboard:
# - NEXT_PUBLIC_API_URL=https://api.subtrack.app
# - NEXT_PUBLIC_WS_URL=wss://api.subtrack.app
# - NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
# - NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME
# - NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET

# Railway (Backend)
# Set these in Railway dashboard:
# - All backend env vars
# - DATABASE_URL (auto-provisioned if using Railway Postgres)
# - REDIS_URL (from Upstash)
# - FRONTEND_URL=https://subtrack.app

# ==================================
# SUPABASE SETUP
# ==================================

# 1. Create project at https://supabase.com
# 2. Go to Settings > Database
# 3. Copy Connection String (URI)
# 4. Replace [PASSWORD] with your password
# 5. Use same URL for DATABASE_URL and DIRECT_URL

# ==================================
# UPSTASH REDIS SETUP
# ==================================

# 1. Create database at https://upstash.com
# 2. Copy REDIS_URL from console
# 3. Copy REST API token as REDIS_TOKEN

# ==================================
# RESEND SETUP
# ==================================

# 1. Sign up at https://resend.com
# 2. Add and verify your domain
# 3. Create API key
# 4. Set EMAIL_FROM to your verified domain

# ==================================
# STRIPE SETUP
# ==================================

# 1. Create account at https://stripe.com
# 2. Get test keys from Dashboard > API Keys
# 3. Create products and prices
# 4. Set up webhook endpoint:
#    - URL: https://api.subtrack.app/api/webhooks/stripe
#    - Events: invoice.payment_succeeded, invoice.payment_failed, 
#              customer.subscription.updated, customer.subscription.deleted
# 5. Copy webhook secret

# ==================================
# OPENAI SETUP
# ==================================

# 1. Get API key from https://platform.openai.com
# 2. Set up billing
# 3. Use gpt-4-turbo-preview or gpt-3.5-turbo

# ==================================
# CLOUDINARY SETUP
# ==================================

# 1. Create account at https://cloudinary.com
# 2. Get credentials from Dashboard
# 3. Create upload preset:
#    - Settings > Upload > Add upload preset
#    - Mode: Unsigned
#    - Folder: subtrack-logos
